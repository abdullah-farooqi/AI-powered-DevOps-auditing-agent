# ==========================================
# DevOps Repository Auditing Agent Configuration
# ==========================================

# --- Primary Provider & Authentication ---
# Primary provider to use: 'gemini' or 'openai_compatible'
LLM_PROVIDER=gemini

# Google Gemini API key (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI-compatible API key (used when LLM_PROVIDER=openai_compatible or fallback)
OPENAI_API_KEY=

# Base URL for OpenAI-compatible endpoint (defaults to https://api.openai.com/v1)
LLM_BASE_URL=https://api.openai.com/v1

# Optional last-resort fallback provider if primary provider fails completely
LLM_FALLBACK_PROVIDER=

# --- Model Selection & Fallback Chain ---
# Primary model for driving tool selection and findings
LLM_MODEL=gemini-3.8-flash

# Comma-separated fallback models in descending priority order
LLM_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Critic model for secondary finding validation pass (lightweight model)
LLM_CRITIC_MODEL=gemini-3.1-flash-lite

# Thinking level for reasoning models ('low', 'medium', 'high', 'minimal')
LLM_THINKING_LEVEL=medium

# Enable or disable LLM critic pass ('true' or 'false', default: true)
ENABLE_CRITIC=true

# --- Execution & Budget Limits ---
# Maximum LLM tool-calling steps (turns) before audit forces completion (default: 40)
MAX_STEPS=40

# Maximum working tree repository size in MB to clone (default: 500)
MAX_REPO_MB=500

# Per-call LLM request timeout in milliseconds (default: 60000)
LLM_TIMEOUT_MS=60000

# Maximum transient error retries per model before fallback (default: 4)
LLM_MAX_RETRIES=4

# Timeout for cloning the repository in seconds (default: 120)
CLONE_TIMEOUT_SECONDS=120

# Timeout for individual inspection tool calls in seconds (default: 30)
TOOL_TIMEOUT_SECONDS=30
